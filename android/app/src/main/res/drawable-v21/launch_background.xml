<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen: the splash sky colour with the app icon, shown
     until Flutter draws the animated SplashScreen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_sky" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
